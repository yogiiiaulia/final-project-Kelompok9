# Environment Variables — Weaponized AI E-Learning Platform
# Copy this file to .env and fill in your values
# Server
PORT=3000
# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/weaponized_ai
# Google Gemini API
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
# Session Secret (use a long random string in production)
SESSION_SECRET=your_very_long_random_secret_here_change_this
# Environment
NODE_ENV=development
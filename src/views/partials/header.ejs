<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Weaponized AI in Cybersecurity' %></title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- FontAwesome & Bootstrap 5 CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Navbar Header -->
  <nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="fas fa-shield-cat"></i>
        <span>Weap<span class="text-gradient-cyan">AI</span> Platform</span>
      </a>
      
      <button class="navbar-toggler border-secondary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fas fa-bars text-cyan-light"></i>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>" href="/">
              <i class="fas fa-house me-1"></i> Beranda
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/materi') ? 'active' : '' %>" href="/materi">
              <i class="fas fa-book-bookmark me-1"></i> Materi Pembelajaran
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/chat') ? 'active' : '' %>" href="/chat">
              <i class="fas fa-robot me-1"></i> AI Assistant
            </a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-3">
          <% if (typeof user !== 'undefined' && user && isAdmin) { %>
            <div class="dropdown">
              <button class="btn btn-outline-cyan btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="admin-badge">ADMIN</span>
                <span><%= user.nama %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-md">
                <li><a class="dropdown-item" href="/admin/dashboard"><i class="fas fa-gauge me-2 text-cyan-light"></i> Dashboard Admin</a></li>
                <li><a class="dropdown-item" href="/admin/sections"><i class="fas fa-list me-2 text-cyan-light"></i> Kelola Sections</a></li>
                <li><a class="dropdown-item" href="/admin/content"><i class="fas fa-file-lines me-2 text-cyan-light"></i> Kelola Konten</a></li>
                <li><hr class="dropdown-divider border-secondary"></li>
                <li>
                  <form action="/admin/logout" method="POST" class="d-inline">
                    <button type="submit" class="dropdown-item text-danger">
                      <i class="fas fa-right-from-bracket me-2"></i> Logout
                    </button>
                  </form>
                </li>
              </ul>
            </div>
          <% } else { %>
            <a href="/admin/login" class="btn btn-outline-cyan btn-sm">
              <i class="fas fa-lock me-1"></i> Portal Admin
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

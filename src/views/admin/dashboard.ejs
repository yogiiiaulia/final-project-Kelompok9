<%- include('../partials/header') %>

<main class="flex-grow-1 py-4">
  <div class="container">
    
    <!-- Dashboard Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
      <div>
        <h2 class="fw-bold text-white mb-1"><i class="fas fa-gauge me-2 text-cyan-light"></i> Dashboard Panel Admin</h2>
        <p class="text-secondary small mb-0">Kelola kurikulum materi, content block, dan pantau statistik RAG AI Assistant.</p>
      </div>

      <div class="d-flex gap-2">
        <a href="/admin/sections" class="btn btn-outline-cyan btn-sm">
          <i class="fas fa-list me-1"></i> Kelola Sections
        </a>
        <a href="/admin/content/new" class="btn btn-cyan btn-sm">
          <i class="fas fa-plus me-1"></i> Tambah Content Block
        </a>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number"><%= stats.sections %></div>
          <div class="stat-label"><i class="fas fa-layer-group me-1 text-cyan-light"></i> Total Sections</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number text-gradient-cyan"><%= stats.blocks %></div>
          <div class="stat-label"><i class="fas fa-cubes me-1 text-cyan-light"></i> Content Blocks</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number text-gradient-purple"><%= stats.sessions %></div>
          <div class="stat-label"><i class="fas fa-comments me-1 text-purple-accent"></i> Chat Sessions</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number" style="color: var(--emerald-accent);"><%= stats.messages %></div>
          <div class="stat-label"><i class="fas fa-message me-1 text-emerald-accent"></i> Total Pesan AI</div>
        </div>
      </div>
    </div>

    <!-- Recent Chat Activity Log Table -->
    <div class="card-custom">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold text-white mb-0"><i class="fas fa-clock-rotate-left me-2 text-cyan-light"></i> Aktivitas Chat Assistant Terakhir</h5>
        <span class="badge bg-dark border border-secondary text-secondary">Top 10 Log</span>
      </div>

      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th style="width: 100px;">Session</th>
              <th style="width: 100px;">Role</th>
              <th>Pesan / Prompt</th>
              <th style="width: 180px;">Waktu</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentMessages && recentMessages.length > 0) { %>
              <% recentMessages.forEach(msg => { %>
                <tr>
                  <td><span class="font-monospace text-cyan-light">#<%= msg.session_id %></span></td>
                  <td>
                    <% if (msg.role === 'user') { %>
                      <span class="badge bg-secondary text-white"><i class="fas fa-user me-1"></i> User</span>
                    <% } else { %>
                      <span class="badge bg-dark border border-info text-cyan-light"><i class="fas fa-robot me-1"></i> AI</span>
                    <% } %>
                  </td>
                  <td class="text-truncate" style="max-width: 450px;"><%= msg.pesan %></td>
                  <td class="text-muted small"><%= new Date(msg.timestamp).toLocaleString('id-ID') %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-3">Belum ada riwayat aktivitas chat.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<main class="flex-grow-1 py-4">
  <div class="container">
    
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
      <div>
        <h2 class="fw-bold text-white mb-1"><i class="fas fa-edit me-2 text-cyan-light"></i> Edit Section</h2>
        <p class="text-secondary small mb-0">Ubah informasi judul bagian atau posisi urutan modul.</p>
      </div>

      <a href="/admin/sections" class="btn btn-outline-cyan btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Kembali ke Daftar Section
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-custom-danger mb-4">
        <i class="fas fa-circle-exclamation me-2"></i><%= error %>
      </div>
    <% } %>

    <div class="card-custom mx-auto p-4 p-md-5" style="max-width: 540px;">
      <form action="/admin/sections/<%= section.id %>/update" method="POST">
        <div class="mb-3">
          <label for="judul_bagian" class="form-label">Judul Section / Bagian</label>
          <input type="text" class="form-control" id="judul_bagian" name="judul_bagian" value="<%= section.judul_bagian %>" required>
        </div>

        <div class="mb-4">
          <label for="urutan" class="form-label">Nomor Urutan</label>
          <input type="number" class="form-control" id="urutan" name="urutan" value="<%= section.urutan %>" min="1" required>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-cyan flex-grow-1">
            <i class="fas fa-floppy-disk me-1"></i> Perbarui Section
          </button>
          <a href="/admin/sections" class="btn btn-outline-secondary">
            Batal
          </a>
        </div>
      </form>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>

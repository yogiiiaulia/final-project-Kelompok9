<%- include('partials/header') %>

<main class="flex-grow-1">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container text-center position-relative" style="z-index: 1;">
      <div class="hero-badge">
        <i class="fas fa-microchip"></i>
        <span>PAW Final Project &mdash; Kelompok 9</span>
      </div>
      
      <h1 class="display-4 fw-extrabold mb-3 text-white">
        Weaponization of <span class="text-gradient-cyan">AI in Cybersecurity</span>
      </h1>
      
      <p class="lead text-secondary max-w-75 mx-auto mb-4" style="max-width: 760px;">
        Platform E-Learning interaktif berbasis studi sistematis oleh <strong>Calvin Nobles (2024)</strong>. Dipadukan dengan RAG AI Assistant yang menjawab pertanyaan secara terukur dan faktual berdasarkan materi pembelajaran.
      </p>

      <div class="d-flex justify-content-center gap-3 mb-5 flex-wrap">
        <a href="/materi" class="btn btn-cyan btn-lg">
          <i class="fas fa-book-open me-2"></i> Mulai Pembelajaran
        </a>
        <a href="/chat" class="btn btn-outline-cyan btn-lg">
          <i class="fas fa-robot me-2"></i> Konsultasi AI Assistant
        </a>
      </div>

      <!-- Stats Cards Row -->
      <div class="row g-4 justify-content-center mt-3">
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-number"><%= typeof sectionCount !== 'undefined' ? sectionCount : 5 %></div>
            <div class="stat-label">Modul / Section Utama</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-number"><%= typeof blockCount !== 'undefined' ? blockCount : 15 %></div>
            <div class="stat-label">Sub-Topik Pembelajaran</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-number text-gradient-purple">RAG</div>
            <div class="stat-label">Grounded AI Retrieval</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-number" style="color: var(--emerald-accent);">2024</div>
            <div class="stat-label">Riset Calvin Nobles</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Highlights -->
  <section class="py-5 bg-card-dark">
    <div class="container py-4">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-white mb-2">Cakupan Topik Pembelajaran</h2>
        <p class="text-secondary">E-Learning ini menyajikan pembahasan mendalam mengenai integrasi Artificial Intelligence dalam lanskap keamanan siber.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card-custom h-100">
            <div class="feature-icon">
              <i class="fas fa-virus-slash"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">Penyalahgunaan AI</h5>
            <p class="text-secondary small mb-0">
              Analisis bagaimana aktor ancaman memanfaatkan AI untuk phishing yang lebih efisien, generasi malware adaptif, dan manipulasi sosial (social engineering).
            </p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card-custom h-100">
            <div class="feature-icon" style="background: rgba(139, 92, 246, 0.15); color: var(--purple-accent); border-color: rgba(139, 92, 246, 0.3);">
              <i class="fas fa-layer-group"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">Kategori & Vektor Ancaman</h5>
            <p class="text-secondary small mb-0">
              Klasifikasi taksonomi serangan AI termasuk Adversarial Attacks, Model Poisoning, Data Evasion, dan eksploitasi kerentanan LLM.
            </p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card-custom h-100">
            <div class="feature-icon" style="background: rgba(16, 185, 129, 0.15); color: var(--emerald-accent); border-color: rgba(16, 185, 129, 0.3);">
              <i class="fas fa-user-shield"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">RAG AI Learning Assistant</h5>
            <p class="text-secondary small mb-0">
              Tanyakan apapun seputar materi. AI Assistant hanya menjawab berdasarkan repositori pengetahuan terverifikasi untuk mencegah halusinasi.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-5 my-4">
    <div class="container">
      <div class="card-custom text-center p-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(21, 28, 44, 0.9), rgba(15, 23, 42, 0.95)); border: 1px solid var(--cyan-primary);">
        <div class="position-relative" style="z-index: 1;">
          <h3 class="fw-bold text-white mb-3">Siap Memahami Ancaman AI dalam Cybersecurity?</h3>
          <p class="text-secondary max-w-50 mx-auto mb-4" style="max-width: 600px;">
            Akses seluruh materi terstruktur dan diskusikan langsung bersama AI Learning Assistant terintegrasi.
          </p>
          <a href="/materi" class="btn btn-cyan btn-lg">
            <i class="fas fa-rocket me-2"></i> Buka Modul 1 Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/chatbot-widget') %>
<%- include('partials/footer') %>

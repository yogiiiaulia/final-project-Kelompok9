<%- include('partials/header') %>

<main class="flex-grow-1 d-flex align-items-center py-5">
  <div class="container text-center">
    <div class="card-custom mx-auto p-5" style="max-width: 600px;">
      <div class="display-1 fw-extrabold text-gradient-purple mb-2">
        <%= typeof status !== 'undefined' ? status : 500 %>
      </div>
      <h3 class="fw-bold text-white mb-3"><%= typeof title !== 'undefined' ? title : 'Terjadi Kesalahan' %></h3>
      
      <p class="text-secondary mb-4">
        <%= typeof message !== 'undefined' ? message : 'Permintaan tidak dapat diproses saat ini.' %>
      </p>

      <% if (typeof stack !== 'undefined' && stack) { %>
        <div class="text-start bg-dark p-3 rounded border border-secondary mb-4 overflow-auto" style="max-height: 200px;">
          <small class="font-monospace text-rose-accent"><%= stack %></small>
        </div>
      <% } %>

      <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-cyan">
          <i class="fas fa-house me-1"></i> Kembali ke Beranda
        </a>
        <a href="/materi" class="btn btn-outline-cyan">
          <i class="fas fa-book me-1"></i> Buka Materi
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
